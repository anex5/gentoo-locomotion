project('niti-vala', 'c', 'vala',
  version: '0.0.0',
  meson_version: '>= 1.0.0',
  default_options: [
    'warning_level=1',
    'buildtype=release',
    'c_std=gnu17'
  ]
)

cc = meson.get_compiler('c')
vala_args = []

if cc.has_function('malloc_trim', prefix: '#include <malloc.h>')
  vala_args += ['--define=HAVE_MALLOC_TRIM']
endif

add_project_arguments(vala_args, language: 'vala')
add_project_arguments('-D_POSIX_C_SOURCE=200809L', language: 'c')

subproject_map = {
  'widget'        : 'api',
  'autoprofile'   : 'services-autoprofile',
  'theme'         : 'services-theme',
  'matugen'       : 'services-matugen',
  'eds'           : 'services-eds',
  'niri'          : 'services-niri',
  'layout'        : 'services-layout',
  'diag'          : 'services-diag',
  'pluginreg'     : 'services-pluginreg',
  'audio'         : 'services-audio',
  'backlight'     : 'services-backlight',
  'network'       : 'services-network',
  'bluetooth'     : 'services-bluetooth',
  'vpn'           : 'services-vpn',
  'caffeine'      : 'services-caffeine',
  'mpris'         : 'services-mpris',
  'upower'        : 'services-upower',
  'applications'  : 'services-applications',
  'notifications' : 'services-notifications',
  'pwrec'         : 'services-pwrec',
  'abooster'      : 'services-abooster',
  'systemtray'    : 'services-systemtray',
  'udisks'        : 'services-udisks',
  'secret-agent'  : 'services-secret-agent',
  'hidpp'         : 'services-hidpp',
  'quickcenter'   : 'modules-quickcenter',
  'hotkeys'       : 'modules-hotkeys',
  'launcher'      : 'modules-launcher',
  'notif'         : 'modules-notifications',
  'calendar'      : 'modules-calendar',
}

api_sub = subproject('api')
meson.override_dependency('niti-widget-1.0', api_sub.get_variable('niti_widget_dep'))

services = [
  'theme', 'matugen', 'eds', 'niri', 'layout', 'diag', 'autoprofile',
  'pluginreg', 'audio', 'backlight', 'network', 'bluetooth', 
  'vpn', 'caffeine', 'mpris', 'upower', 'applications', 
  'notifications', 'pwrec', 'abooster', 'systemtray', 'udisks', 
  'secret-agent', 'hidpp'
]

foreach s : services
  sub = subproject('services-' + s)
  var_suffix = (s == 'secret-agent') ? 'secret_agent' : s
  meson.override_dependency('niti-' + s + '-1.0', sub.get_variable('niti_' + var_suffix + '_dep'))
endforeach

modules = [
  'quickcenter', 'hotkeys', 'launcher', 'notifications', 'calendar'
]

foreach m : modules
  sub = subproject('modules-' + m)
  var_suffix = (m == 'notifications') ? 'notif' : m
  meson.override_dependency('niti-' + var_suffix + '-1.0', sub.get_variable('niti_' + var_suffix + '_dep'))
endforeach

widgets = [
  'clock', 'workspaces', 'quickbutton', 'media', 'power', 
  'vitals', 'keyboard', 'tray', 'disks', 'systeminfo', 
  'recording', 'hotkeys', 'tasks', 'caffeine', 'layouts'
]

foreach w : widgets
  subproject('widgets-' + w)
endforeach

subproject('core')
